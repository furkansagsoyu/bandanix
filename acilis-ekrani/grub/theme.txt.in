# Bandanix GRUB theme. @FONT_ITEM@ and @FONT_SMALL@ are filled in at install time
# with the names of the fonts made by grub-mkfont.
title-text: ""
desktop-color: "#000000"
terminal-font: "@FONT_SMALL@"

+ image {
  left = 50%-117
  top = 18%
  file = "wordmark.png"
}

+ boot_menu {
  left = 50%-320
  top = 30%
  width = 640
  height = 50%
  item_font = "@FONT_ITEM@"
  selected_item_font = "@FONT_ITEM@"
  item_color = "#A0A0AB"
  selected_item_color = "#FFFFFF"
  item_height = 44
  item_padding = 14
  item_spacing = 8
  icon_width = 0
  icon_height = 0
  item_icon_space = 0
  selected_item_pixmap_style = "select_*.png"
  scrollbar = false
}

+ label {
  id = "__timeout__"
  left = 0
  top = 100%-96
  width = 100%
  height = 24
  align = "center"
  color = "#A0A0AB"
  font = "@FONT_SMALL@"
  text = "%d saniye sonra açılacak"
}

+ label {
  left = 0
  top = 100%-60
  width = 100%
  height = 24
  align = "center"
  color = "#737380"
  font = "@FONT_SMALL@"
  text = "↑ ↓ seç   ·   Enter başlat   ·   e düzenle   ·   c komut satırı"
}
